{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.local/schemas/event.schema.json",
  "title": "Skynet Memory Event",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "type",
    "source",
    "summary"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": [
        "user-statement",
        "tool-observation",
        "decision",
        "task-status",
        "error",
        "resolution",
        "environment-confirmation"
      ]
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "session": { "type": ["string", "null"] },
        "workspace": { "type": ["string", "null"] },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": ["object", "array", "string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
