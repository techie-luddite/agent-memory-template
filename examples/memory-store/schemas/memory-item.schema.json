{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.local/schemas/memory-item.schema.json",
  "title": "Skynet Memory Item",
  "type": "object",
  "required": [
    "id",
    "state",
    "truth_class",
    "scope",
    "summary",
    "assertion",
    "confidence",
    "importance",
    "retrieval_weight",
    "status",
    "source",
    "created_at",
    "updated_at",
    "tags"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["active", "durable", "suppressed"]
    },
    "truth_class": {
      "type": "string",
      "enum": [
        "preference",
        "environment",
        "project",
        "operational",
        "relationship",
        "policy",
        "decision"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "subject": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "assertion": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "retrieval_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["candidate", "confirmed", "superseded", "invalid", "inactive"]
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "session": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_reinforced_at": { "type": ["string", "null"], "format": "date-time" },
    "last_reinforced_in_session": { "type": ["string", "null"] },
    "reinforcement_count": { "type": "integer", "minimum": 0 },
    "review_after_sessions": { "type": ["integer", "null"], "minimum": 0 },
    "review_after_interactions": { "type": ["integer", "null"], "minimum": 0 },
    "activity_state": {
      "type": ["string", "null"],
      "enum": ["open", "resolved", "dormant", null]
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_by": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
